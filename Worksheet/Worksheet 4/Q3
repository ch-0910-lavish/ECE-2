<!DOCTYPE html>
<html lang="en">
<head>
    <title>Box Model Example</title>
    <style>
        .card {
            width: 300px;                 /* Required width */
            padding: 20px;                /* Task 1: Padding */
            margin: 30px auto;            /* Task 2: Center + margin */
            border: 2px solid #333;       /* Task 3: Border */
            text-align: center;           /* Centered text (optional but looks nicer) */
            font-family: Arial, sans-serif;
            border-radius: 8px;           /* Extra touch: smooth corners */
            background-color: #f9f9f9;    /* Light background for better look */
        }
    </style>
</head>

<body>

    <div class="card">
        <h3>Box Model Example</h3>
        <p>This box uses padding, margin, and border.</p>
    </div>

</body>
</html>
